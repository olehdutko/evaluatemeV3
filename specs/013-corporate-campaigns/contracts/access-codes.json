{
  "name": "Access Codes API",
  "endpoints": [
    {
      "method": "POST",
      "path": "/api/v1/corporate/campaigns/:campaignId/access-codes",
      "body": {
        "companyId": "uuid",
        "quizId": "uuid",
        "quizType": "technology | company_quiz",
        "technologyId": "uuid | null"
      },
      "response": {
        "data": {
          "id": "uuid",
          "code": "string"
        }
      }
    },
    {
      "method": "GET",
      "path": "/api/v1/corporate/campaigns/:campaignId/access-codes?companyId=",
      "response": {
        "data": [
          {
            "id": "uuid",
            "code": "string",
            "status": "active | used | expired | revoked",
            "sentAt": "ISO 8601 | null",
            "sentToEmail": "string | null",
            "usedCount": "number",
            "maxUses": "number",
            "usedAt": "ISO 8601 | null",
            "createdAt": "ISO 8601"
          }
        ]
      }
    },
    {
      "method": "POST",
      "path": "/api/v1/corporate/access-codes/:id/send",
      "body": {
        "companyId": "uuid",
        "email": "string"
      },
      "response": {
        "data": {
          "sentAt": "ISO 8601"
        }
      }
    }
  ]
}
