{
  "name": "@evaluateme/api",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS backend API for EvaluateMe v3",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint '{src,tests}/**/*.ts'",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js"
  },
  "dependencies": {
    "@evaluateme/domain": "*",
    "@evaluateme/prisma": "*",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "bcrypt": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "jsonwebtoken": "^9.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@evaluateme/tsconfig": "*",
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.0",
    "dotenv": "^17.4.2",
    "ts-node": "^10.9.2"
  }
}
