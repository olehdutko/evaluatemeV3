{
  "extends": "@evaluateme/tsconfig/tsconfig.json",
  "compilerOptions": {
    "outDir": "./.next",
    "rootDir": ".",
    "jsx": "preserve",
    "composite": false,
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
