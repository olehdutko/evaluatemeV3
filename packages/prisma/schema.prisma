generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============= v3 Business Entities =============

model User {
  id                String            @id @default(uuid()) @db.VarChar(36)
  email             String            @unique @db.VarChar(255)
  username          String?           @unique @db.VarChar(100)
  passwordHash      String?           @db.VarChar(255)
  legacyMd5Hash     String?           @db.VarChar(255)
  role              String            @db.VarChar(20)
  activationStatus  String            @db.VarChar(20)
  companyProfileId  String?           @unique @db.VarChar(36)
  credits           Int               @default(0)
  firstName         String?           @db.VarChar(100)
  lastName          String?           @db.VarChar(100)
  middleName        String?           @db.VarChar(100)
  birthDate         DateTime?         @db.Date
  country           String?           @db.VarChar(100)
  city              String?           @db.VarChar(100)
  phone             String?           @db.VarChar(50)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("users")
}

model CompanyProfile {
  id                    String    @id @default(uuid()) @db.VarChar(36)
  userId                String    @unique @db.VarChar(36)
  companyName           String    @db.VarChar(255)
  address               String?   @db.VarChar(255)
  phone                 String?   @db.VarChar(50)
  country               String?   @db.VarChar(100)
  occupation            String?   @db.VarChar(100)
  availableTests        Int       @default(0)
  availableAccessCodes  Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("company_profiles")
}

model Campaign {
  id              String    @id @default(uuid()) @db.VarChar(36)
  companyId       String?   @db.VarChar(36)
  name            String    @db.VarChar(255)
  description     String?   @db.Text
  notes           String?   @db.Text
  status          String    @db.VarChar(20)
  createdByUserId String    @db.VarChar(36)
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId])
  @@index([companyId, status])
  @@map("campaigns")
}

model CampaignHistory {
  id              String   @id @default(uuid()) @db.VarChar(36)
  campaignId      String   @db.VarChar(36)
  action          String   @db.VarChar(50)
  status          String?  @db.VarChar(20)
  changedByUserId String   @db.VarChar(36)
  metadata        String?  @db.Text
  changedAt       DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([campaignId])
  @@map("campaign_history")
}

model Technology {
  id          String   @id @default(uuid()) @db.VarChar(36)
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("technologies")
}

model QuestionSet {
  id                  String   @id @default(uuid()) @db.VarChar(36)
  title               String   @db.VarChar(255)
  technologyId        String   @db.VarChar(36)
  status              String   @db.VarChar(20)
  quizQuestionCount   Int      @default(20)
  quizDurationMinutes Int      @default(40)
  createdByUserId     String   @db.VarChar(36)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([technologyId, title])
  @@map("question_sets")
}

model Question {
  id            String   @id @default(uuid()) @db.VarChar(36)
  questionSetId String   @db.VarChar(36)
  content       String   @db.Text
  type          String   @db.VarChar(20)
  orderIndex    Int
  score         Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([questionSetId, orderIndex])
  @@map("questions")
}

model Answer {
  id          String   @id @default(uuid()) @db.VarChar(36)
  questionId  String   @db.VarChar(36)
  content     String   @db.Text
  isCorrect   Boolean
  orderIndex  Int
  createdAt   DateTime @default(now())

  @@unique([questionId, orderIndex])
  @@map("answers")
}

model QuizSession {
  id                   String    @id @default(uuid()) @db.VarChar(36)
  userId               String?   @db.VarChar(36)
  questionSetId        String    @db.VarChar(36)
  accessCodeId         String?   @db.VarChar(36)
  status               String    @db.VarChar(20)
  startedAt            DateTime  @default(now())
  completedAt          DateTime?
  score                Int?
  currentQuestionIndex Int       @default(0)
  questionIdsSnapshot  String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([questionSetId])
  @@map("quiz_sessions")
}

model UserAnswer {
  id            String   @id @default(uuid()) @db.VarChar(36)
  testSessionId String   @db.VarChar(36)
  questionId    String   @db.VarChar(36)
  answerId      String   @db.VarChar(36)
  isCorrect     Boolean
  answeredAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("user_answers")
}

model FreeSampleQuestion {
  id           String   @id @default(uuid()) @db.VarChar(36)
  technologyId String   @db.VarChar(36)
  content      String   @db.Text
  type         String   @db.VarChar(20)
  explanation  String?  @db.Text
  createdAt    DateTime @default(now())

  @@map("free_sample_questions")
}

model UserSession {
  id            String    @id @default(uuid()) @db.VarChar(36)
  sessionId     String    @db.VarChar(255)
  questionId    String    @db.VarChar(36)
  userId        String    @db.VarChar(36)
  technologyId  String    @db.VarChar(36)
  answerId      String?   @db.VarChar(36)
  status        String    @db.VarChar(20)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@unique([sessionId, questionId])
  @@map("user_sessions")
}

model UserResult {
  id            String    @id @default(uuid()) @db.VarChar(36)
  resultCode    String    @unique @db.VarChar(255)
  userId        String    @db.VarChar(36)
  technologyId  String?   @db.VarChar(36)
  questionSetId String?   @db.VarChar(36)
  score         Int?
  maxScore      Int?
  status        String    @db.VarChar(20)
  sessionId     String?   @db.VarChar(255)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([questionSetId])
  @@map("user_results")
}

model CandidateSession {
  id            String    @id @default(uuid()) @db.VarChar(36)
  sessionId     String    @db.VarChar(255)
  questionId    String    @db.VarChar(36)
  candidateId   String?   @db.VarChar(36)
  accessCodeId  String    @db.VarChar(36)
  technologyId  String    @db.VarChar(36)
  answerId      String?   @db.VarChar(36)
  status        String    @db.VarChar(20)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@unique([sessionId, questionId])
  @@map("candidate_sessions")
}

model CandidateResult {
  id            String    @id @default(uuid()) @db.VarChar(36)
  resultCode    String    @unique @db.VarChar(255)
  campaignId    String?   @db.VarChar(36)
  candidateId   String?   @db.VarChar(36)
  accessCodeId  String?   @db.VarChar(36)
  technologyId  String?   @db.VarChar(36)
  questionSetId String?   @db.VarChar(36)
  companyQuizId String?   @db.VarChar(36)
  score         Int?
  maxScore      Int?
  status        String    @db.VarChar(20)
  sessionId     String?   @db.VarChar(255)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([campaignId])
  @@index([questionSetId])
  @@map("candidate_results")
}

model AccessCode {
  id              String    @id @default(uuid()) @db.VarChar(36)
  code            String    @unique @db.VarChar(100)
  companyId       String    @db.VarChar(36)
  campaignId      String?   @db.VarChar(36)
  quizId          String?   @db.VarChar(36)
  questionSetId   String?   @db.VarChar(36)
  status          String    @db.VarChar(20)
  sentAt          DateTime?
  sentToEmail     String?   @db.VarChar(255)
  usedCount       Int       @default(0)
  maxUses         Int       @default(1)
  expiresAt       DateTime?
  usedAt          DateTime?
  testeeName      String?   @db.VarChar(255)
  testeeEmail     String?   @db.VarChar(255)
  questionCount   Int?
  durationMinutes Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId])
  @@index([campaignId])
  @@index([questionSetId])
  @@map("access_codes")
}

model Order {
  id          String   @id @default(uuid()) @db.VarChar(36)
  orderNumber String   @unique @db.VarChar(100)
  userId      String   @db.VarChar(36)
  amount      Decimal  @db.Decimal(10, 2)
  currency    String   @default("USD") @db.VarChar(3)
  status      String   @db.VarChar(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("orders")
}

model EmailTemplate {
  id        String   @id @default(uuid()) @db.VarChar(36)
  name      String   @unique @db.VarChar(100)
  subject   String   @db.VarChar(255)
  bodyHtml  String   @db.Text
  bodyText  String?  @db.Text
  variables String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

model CompanyQuiz {
  id              String   @id @default(uuid()) @db.VarChar(36)
  companyId       String   @db.VarChar(36)
  type            String   @db.VarChar(20)
  name            String   @db.VarChar(255)
  description     String?  @db.Text
  status          String   @db.VarChar(20)
  createdByUserId String   @db.VarChar(36)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId])
  @@map("company_quizzes")
}

model CustomQuizQuestion {
  id            String @id @default(uuid()) @db.VarChar(36)
  companyQuizId String @db.VarChar(36)
  questionId    String @db.VarChar(36)
  orderIndex    Int

  @@unique([companyQuizId, questionId])
  @@index([companyQuizId])
  @@map("custom_quiz_questions")
}

model CompanyQuizQuestion {
  id            String  @id @default(uuid()) @db.VarChar(36)
  companyQuizId String  @db.VarChar(36)
  content       String  @db.Text
  type          String  @db.VarChar(20)
  orderIndex    Int
  score         Int     @default(1)

  @@unique([companyQuizId, orderIndex])
  @@index([companyQuizId])
  @@map("company_quiz_questions")
}

model CompanyQuizAnswer {
  id                    String  @id @default(uuid()) @db.VarChar(36)
  companyQuizQuestionId String  @db.VarChar(36)
  content               String  @db.Text
  isCorrect             Boolean
  orderIndex            Int

  @@unique([companyQuizQuestionId, orderIndex])
  @@index([companyQuizQuestionId])
  @@map("company_quiz_answers")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @db.VarChar(36)
  tokenHash String    @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@map("password_reset_tokens")
}

model LandingAd {
  id        String   @id @default(uuid()) @db.VarChar(36)
  title     String   @db.VarChar(255)
  content   String?  @db.Text
  imageUrl  String?  @db.VarChar(500)
  linkUrl   String?  @db.VarChar(500)
  position  String   @db.VarChar(20)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("landing_ads")
}

model CreditSetting {
  id              String   @id @default(uuid()) @db.VarChar(36)
  key             String   @unique @db.VarChar(100)
  value           String   @db.Text
  updatedByUserId String   @db.VarChar(36)
  updatedAt       DateTime @updatedAt

  @@map("credit_settings")
}

model EmailServiceConfig {
  id             String   @id @default(uuid()) @db.VarChar(36)
  provider       String   @default("custom") @db.VarChar(50)
  smtpHost       String   @db.VarChar(255)
  smtpPort       Int
  smtpUser       String   @db.VarChar(255)
  smtpPass       String   @db.Text
  fromEmail      String   @db.VarChar(255)
  secure         Boolean  @default(false)
  enabled        Boolean  @default(false)
  updatedByUserId String  @db.VarChar(36)
  updatedAt      DateTime @updatedAt

  @@map("email_service_configs")
}

// ============= Legacy Read-Only Reference Models =============
// These models map existing MyISAM tables and MUST NOT be written to in feature code.

model LegacyUser {
  id       Int     @id @default(autoincrement()) @db.UnsignedInt
  email    String  @unique @db.VarChar(255)
  password String? @db.VarChar(255)
  role     String? @db.VarChar(20)
  status   Int?
  created  DateTime? @db.DateTime(0)

  @@map("Users")
}

model LegacyCompany {
  id           Int     @id @default(autoincrement()) @db.UnsignedInt
  companyName  String? @map("company_name") @db.VarChar(255)
  email        String? @db.VarChar(255)
  address      String? @db.VarChar(255)
  phone        String? @db.VarChar(50)
  country      String? @db.VarChar(100)
  occupation   String? @db.VarChar(100)
  tests        Int?
  accessCodes  Int?    @map("access_codes")
  created      DateTime? @db.DateTime(0)

  @@map("Companies")
}

model LegacyStudent {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  sessionId String? @map("session_id") @db.VarChar(255)
  userId    Int?
  testId    Int?
  questionId Int?   @map("question_id")
  answer    String? @db.Text
  status    String? @db.VarChar(20)
  started   DateTime? @db.DateTime(0)
  completed DateTime? @db.DateTime(0)
  created   DateTime? @db.DateTime(0)

  @@map("Students")
}

model LegacyResult {
  id         Int     @id @default(autoincrement()) @db.UnsignedInt
  resultCode String? @map("result_code") @db.VarChar(255)
  userId     Int?
  testId     Int?
  score      Int?
  maxScore   Int?    @map("max_score")
  status     String? @db.VarChar(20)
  sessionId  String? @map("session_id") @db.VarChar(255)
  created    DateTime? @db.DateTime(0)

  @@map("Results")
}

model LegacyCandidate {
  id        Int     @id @default(autoincrement()) @db.UnsignedInt
  sessionId String? @map("session_id") @db.VarChar(255)
  testId    Int?
  questionId Int?   @map("question_id")
  answer    String? @db.Text
  status    String? @db.VarChar(20)
  started   DateTime? @db.DateTime(0)
  completed DateTime? @db.DateTime(0)
  created   DateTime? @db.DateTime(0)

  @@map("Candidates")
}

model LegacyCandidateResult {
  id         Int     @id @default(autoincrement()) @db.UnsignedInt
  resultCode String? @map("result_code") @db.VarChar(255)
  candidateId Int?   @map("candidate_id")
  testId     Int?
  score      Int?
  maxScore   Int?    @map("max_score")
  status     String? @db.VarChar(20)
  sessionId  String? @map("session_id") @db.VarChar(255)
  created    DateTime? @db.DateTime(0)

  @@map("Candidates_results")
}

model TokenBlacklist {
  id          String   @id @default(uuid()) @db.VarChar(36)
  tokenHash   String   @unique @db.VarChar(255)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("token_blacklist")
}
