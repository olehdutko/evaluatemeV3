// New tables for test engine
model Test {
  id              String   @id @default(uuid()) @db.VarChar(36)
  title           String   @db.VarChar(255)
  technologyId    String   @db.VarChar(36)
  status          String   @db.VarChar(20)  @default("active")
  durationMinutes Int?
  passingScore    Int?
  createdByUserId String?  @db.VarChar(36)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([technologyId, title])
  @@map("tests")
}

model TestSession {
  id                   String    @id @default(uuid()) @db.VarChar(36)
  userId               String?   @db.VarChar(36)
  testId               String    @db.VarChar(36)
  accessCodeId         String?   @db.VarChar(36)
  status               String    @db.VarChar(20)  @default("in_progress")
  startedAt            DateTime  @default(now())
  completedAt          DateTime?
  score                Int?
  currentQuestionIndex Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("test_sessions")
}

model UserAnswer {
  id            String   @id @default(uuid()) @db.VarChar(36)
  testSessionId String   @db.VarChar(36)
  questionId    String   @db.VarChar(36)
  answerId      String   @db.VarChar(36)
  isCorrect     Boolean
  answeredAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("user_answers")
}
